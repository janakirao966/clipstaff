{
  "manifest_version": 3,
  "name": "ClipStaff PRO",
  "version": "0.0.5",
  "description": "Recruitment Clipboard Assistant Browser Extension",
  "icons": {
    "16": "public/icons/icon16.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "clipboardWrite",
    "clipboardRead",
    "scripting",
    "downloads",
    "contextMenus"
  ],
  "commands": {
    "save-current-job": {
      "suggested_key": {
        "default": "Alt+Shift+J",
        "mac": "Alt+Shift+J"
      },
      "description": "Save current job application URL to ClipStaff"
    }
  },
  "host_permissions": [
    "https://*/*",
    "http://*/*",
    "https://docs.google.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "action": {
    "default_icon": {
      "16": "public/icons/icon16.png",
      "48": "public/icons/icon48.png",
      "128": "public/icons/icon128.png"
    }
  },
  "options_page": "index.html",
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["src/content.ts"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://*.supabase.co https://docs.google.com https://*.googleusercontent.com https://generativelanguage.googleapis.com;"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "public/icons/icon16.png",
        "public/icons/icon48.png",
        "public/icons/icon128.png",
        "public/icon.svg",
        "index.html",
        "assets/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
